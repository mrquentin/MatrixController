<?xml version="1.0" encoding="utf-8"?>
<!-- A 4x4 LED-matrix glyph: most pixels unlit (dim), one RGB diagonal lit, echoing the Matrix
     Portal M4's physical display. Circles are drawn as two-arc subpaths so the shape stays a
     crisp dot at every launcher size. Grid kept inside the ~66dp adaptive-icon safe zone. This
     drawable also serves as the monochrome/themed-icon layer: the system recolors it from its
     alpha channel alone, so the dim/lit contrast still reads once tinted. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Unlit pixels. -->
    <path
        android:fillColor="#33FFFFFF"
        android:pathData="
            M48,31.5a4.5,4.5 0 1,0 0,9a4.5,4.5 0 1,0 0,-9z
            M60,31.5a4.5,4.5 0 1,0 0,9a4.5,4.5 0 1,0 0,-9z
            M72,31.5a4.5,4.5 0 1,0 0,9a4.5,4.5 0 1,0 0,-9z
            M36,43.5a4.5,4.5 0 1,0 0,9a4.5,4.5 0 1,0 0,-9z
            M60,43.5a4.5,4.5 0 1,0 0,9a4.5,4.5 0 1,0 0,-9z
            M72,43.5a4.5,4.5 0 1,0 0,9a4.5,4.5 0 1,0 0,-9z
            M36,55.5a4.5,4.5 0 1,0 0,9a4.5,4.5 0 1,0 0,-9z
            M48,55.5a4.5,4.5 0 1,0 0,9a4.5,4.5 0 1,0 0,-9z
            M72,55.5a4.5,4.5 0 1,0 0,9a4.5,4.5 0 1,0 0,-9z
            M36,67.5a4.5,4.5 0 1,0 0,9a4.5,4.5 0 1,0 0,-9z
            M48,67.5a4.5,4.5 0 1,0 0,9a4.5,4.5 0 1,0 0,-9z
            M60,67.5a4.5,4.5 0 1,0 0,9a4.5,4.5 0 1,0 0,-9z" />
    <!-- Lit RGB diagonal. -->
    <path android:fillColor="#FF5C5C" android:pathData="M36,31.5a4.5,4.5 0 1,0 0,9a4.5,4.5 0 1,0 0,-9z" />
    <path android:fillColor="#FFC048" android:pathData="M48,43.5a4.5,4.5 0 1,0 0,9a4.5,4.5 0 1,0 0,-9z" />
    <path android:fillColor="#4CD97B" android:pathData="M60,55.5a4.5,4.5 0 1,0 0,9a4.5,4.5 0 1,0 0,-9z" />
